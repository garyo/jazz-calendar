[Unit]
Description=Boston Jazz Calendar scrape and publish
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=jazzcal
WorkingDirectory=/opt/jazz-calendar/scraper
EnvironmentFile=/etc/jazzcal.env
ExecStart=/usr/local/bin/uv run --frozen jazzcal run --publish
Nice=10
TimeoutStartSec=45min
