# Copy to ~/.config/jazzcal/env (macOS) or /etc/jazzcal.env (Linux), mode 600, and fill in.
JAZZCAL_PUBLISH_TOKEN=change-me
# JAZZCAL_SITE=https://bostonjazzcalendar.com
# Optional: ask a model about listings the keyword rules can't settle (see scraper/README.md).
# JAZZCAL_CLASSIFIER=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# Ticketmaster Discovery API key (free developer account); used for Regattabar and Scullers.
TICKETMASTER_API_KEY=
# Pinged after each successful run (e.g. a healthchecks.io check URL); optional.
# JAZZCAL_HEALTHCHECK_URL=
# Where the cache, database and built files live (default: scraper/var).
# JAZZCAL_VAR=/var/lib/jazzcal
