[Unit]
Description=Republish Boston Jazz Calendar submissions if the site has changes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=jazzcal
WorkingDirectory=/opt/jazz-calendar/scraper
EnvironmentFile=/etc/jazzcal.env
# When the site has asked for a run (refresh exits 10), pull the latest main and carry it out.
ExecStart=/bin/sh -c '/usr/local/bin/uv run --frozen jazzcal refresh; s=$$?; [ $$s -eq 10 ] || exit $$s; git pull --ff-only --quiet; exec /usr/local/bin/uv run --frozen jazzcal requested'
Nice=10
TimeoutStartSec=45min
