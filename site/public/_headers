/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://analytics.oberbrunner.com/tracker.js https://challenges.cloudflare.com 'sha256-f0AoJbEfKaiCzwVmKseLlZJU6qybXMDU6UmbBBVTYwE='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://analytics.oberbrunner.com/api/collect; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

# Scripts and stylesheets, renamed by their content's hash at build
# (scripts/build.ts), never change, so browsers keep them for a year. Pages
# and everything else keep the default, max-age=0, must-revalidate; a
# Cache-Control here on /* would be joined to this one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# A second policy for the review page. Both apply, so it runs only its own
# scripts and talks only to this site: no analytics, no Turnstile.
/admin*
  Content-Security-Policy: script-src 'self'; connect-src 'self'; frame-src 'none'
